              }
            },
            "required": ["op"]
          },
          "then": {
            "$ref": "#/$defs/resize_opening"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "create_space"
              }
            },
            "required": ["op"]
          },
          "then": {
            "$ref": "#/$defs/create_space"
          }
        },
        {
          "if": {
            "properties": {
