    "add_annotation": {
      "type": "object",
      "description": "Add a free text annotation at a position. Annotations are drawing notes. They never influence geometry or validation.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "x_mm": {
  "type": "integer",
  "maximum": 1000000000,
  "minimum": -1000000000
}, "y_mm": {
  "type": "integer",
  "maximum": 1000000000,
  "minimum": -1000000000
} },
          "required": ["x_mm", "y_mm"]
        },
        "rotation_deg": {
          "type": "number",
          "maximum": 360,
          "minimum": -360
        },
        "text": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        },
        "annotation_kind": {
          "enum": ["note", "label", "room_tag", "north_arrow", "scale_bar", "title"]
        },
        "op": {
          "const": "add_annotation"
        },
        "level_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": ["op", "position", "text"],
      "title": "add_annotation"
    },
    "add_dimension": {
      "type": "object",
      "description": "Add a dimension line between two points. The measured value is always derived from the two points and is never stored separately.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "x_mm": {
  "type": "integer",
  "maximum": 1000000000,
  "minimum": -1000000000
}, "y_mm": {
  "type": "integer",
  "maximum": 1000000000,
  "minimum": -1000000000
} },
          "required": ["x_mm", "y_mm"]
        },
        "end": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "x_mm": {
  "type": "integer",
  "maximum": 1000000000,
  "minimum": -1000000000
}, "y_mm": {
  "type": "integer",
  "maximum": 1000000000,
  "minimum": -1000000000
} },
          "required": ["x_mm", "y_mm"]
        },
        "offset_mm": {
          "type": "integer",
          "maximum": 100000,
          "minimum": -100000
        },
        "label_override": {
          "type": "string",
          "maxLength": 100
        },
        "provenance": {
          "enum": ["provided", "measured", "parsed", "derived", "estimated", "unknown"]
        },
        "confidence": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "op": {
          "const": "add_dimension"
        },
        "level_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": ["op", "start", "end"],
      "title": "add_dimension"
    },
    "convert_opening": {
      "type": "object",
      "description": "Convert an opening into another type, e.g. a door into an open passage. Keeps id, host wall and position. Attributes that do not apply to the new type are dropped, and the attributes required by the new type must be supplied. This is the operation for \"remove the door and make it a 1.60 m opening\" — it keeps the identity of the opening instead of deleting and recreating it.",
      "additionalProperties": false,
      "properties": {
        "width_mm": {
          "type": "integer",
          "minimum": 1
        },
        "height_mm": {
          "type": "integer",
          "minimum": 1
        },
        "sill_mm": {
          "type": "integer",
          "minimum": 0
        },
        "door_type": {
          "enum": ["swing", "double", "sliding", "pocket", "folding", "garage", "revolving"]
        },
        "hinge": {
          "enum": ["left", "right"]
        },
        "swing": {
          "enum": ["left", "right", "none"]
        },
        "window_type": {
          "enum": ["fixed", "casement", "tilt_turn", "sliding", "french", "skylight"]
        },
        "has_threshold": {
          "type": "boolean"
        },
        "state": {
          "enum": ["existing", "planned", "new", "demolish", "unknown"]
        },
        "provenance": {
          "enum": ["provided", "measured", "parsed", "derived", "estimated", "unknown"]
        },
        "confidence": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        },
        "op": {
          "const": "convert_opening"
        },
        "target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "to_type": {
          "enum": ["door", "window", "passage", "generic_opening"]
        }
      },
      "required": ["op", "target_id", "to_type"],
      "title": "convert_opening"
    },
    "create_door": {
      "type": "object",
      "description": "Create a door in a wall. offset_mm is the distance from wall.start to the CENTRE of the opening, measured along the wall centerline. The operation fails if the opening does not fit or overlaps an existing one.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "width_mm": {
          "type": "integer",
          "minimum": 1
        },
        "height_mm": {
          "type": "integer",
          "minimum": 1
        },
        "offset_mm": {
          "type": "integer",
          "minimum": 0
        },
        "host_wall_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "door_type": {
          "enum": ["swing", "double", "sliding", "pocket", "folding", "garage", "revolving"]
        },
        "hinge": {
          "enum": ["left", "right"]
        },
        "swing": {
          "enum": ["left", "right", "none"]
        },
        "connects_space_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxItems": 2,
          "minItems": 1
        },
        "state": {
          "enum": ["existing", "planned", "new", "demolish", "unknown"]
        },
        "provenance": {
          "enum": ["provided", "measured", "parsed", "derived", "estimated", "unknown"]
        },
        "confidence": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        },
        "verified": {
          "type": "boolean"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "op": {
          "const": "create_door"
        }
      },
      "required": ["op", "host_wall_id", "offset_mm", "width_mm", "door_type"],
      "title": "create_door"
    },
    "create_level": {
      "type": "object",
      "description": "Add a level to a building. Creates an empty level. The building defaults to the first building in the document.",
      "additionalProperties": false,
      "properties": {
        "id": {
